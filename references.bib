@article{meng_depth-assisted_2021,
	title = {A {Depth}-assisted {Feature} {Homogenization} {Strategy} for {Vision}-related {SLAM} in {Complex} {Environment}},
	abstract = {Vision-related state estimation typically suffers from the clustered feature points, which compromises the stability of the system. This letter proposed a robust feature homogenization method that can distribute feature points on the image plane and change the depth distribution of feature points for better feature tracking. The proposed method was implemented by enforcing a dynamic minimum distance between neighboring feature points. The minimum distance was determined by the relationship between the depth of feature points and the velocity of optical ﬂow. With the assistance of depth information, the proposed method developed a preference for feature points with smaller depths in feature homogenization. We applied the proposed method into VINS-Mono, a state-of-art visual-inertial system. We compared the modiﬁed and original systems by using synthesized datasets and the public EuRoC datasets. Experimental results show that the proposed method improves global consistency and tracking stability of the system by integrating depth information into feature homogenization. Index Terms— State estimation; Feature; Homogenization; SLAM; Depth distribution.},
	language = {en},
	author = {Meng, Xiantong and Lai, Zhengchao and guo, shangwei and Han, Shaokun and Li, Jun},
	year = {2021},
	pages = {8},
}

@article{krasner_signav_nodate,
	title = {{SIGNAV}: {Semantically}-{Informed} {GPS}-{Denied} {Navigation} and {Mapping} in {Visually}-{Degraded} {Environments}},
	abstract = {Understanding the perceived scene during navigation enables intelligent robot behaviors. Current vision-based semantic SLAM (Simultaneous Localization and Mapping) systems provide these capabilities. However, their performance decreases in visually-degraded environments, that are common places for critical robotic applications, such as search and rescue missions. In this paper, we present SIGNAV, a real-time semantic SLAM system to operate in perceptually-challenging situations. To improve the robustness for navigation in dark environments, SIGNAV leverages a multi-sensor navigation architecture to fuse vision with additional sensing modalities, including an inertial measurement unit (IMU), LiDAR, and wheel odometry. A new 2.5D semantic segmentation method is also developed to combine both images and LiDAR depth maps to generate semantic labels of 3D mapped points in real time. We demonstrate that the navigation accuracy from SIGNAV in a variety of indoor environments under both normal lighting and dark conditions. SIGNAV also provides semantic scene understanding capabilities in visually-degraded environments. We also show the beneﬁts of semantic information to SIGNAV’s performance.},
	language = {en},
	author = {Krasner, Alex and Sizintsev, Mikhail and Rajvanshi, Abhinav and Chiu, Han-Pang and Mithun, Niluthpol and Kaighn, Kevin and Miller, Philip and Villamil, Ryan and Samarasekera, Supun},
	pages = {10},
}

@article{lionar_neuralblox_2021,
	title = {{NeuralBlox}: {Real}-{Time} {Neural} {Representation} {Fusion} for {Robust} {Volumetric} {Mapping}},
	shorttitle = {{NeuralBlox}},
	url = {http://arxiv.org/abs/2110.09415},
	abstract = {We present a novel 3D mapping method leveraging the recent progress in neural implicit representation for 3D reconstruction. Most existing state-of-the-art neural implicit representation methods are limited to object-level reconstructions and can not incrementally perform updates given new data. In this work, we propose a fusion strategy and training pipeline to incrementally build and update neural implicit representations that enable the reconstruction of large scenes from sequential partial observations. By representing an arbitrarily sized scene as a grid of latent codes and performing updates directly in latent space, we show that incrementally built occupancy maps can be obtained in real-time even on a CPU. Compared to traditional approaches such as Truncated Signed Distance Fields (TSDFs), our map representation is significantly more robust in yielding a better scene completeness given noisy inputs. We demonstrate the performance of our approach in thorough experimental validation on real-world datasets with varying degrees of added pose noise.},
	urldate = {2021-10-25},
	journal = {arXiv:2110.09415 [cs]},
	author = {Lionar, Stefan and Schmid, Lukas and Cadena, Cesar and Siegwart, Roland and Cramariuc, Andrei},
	month = oct,
	year = {2021},
	note = {arXiv: 2110.09415},
	keywords = {Computer Science - Computer Vision and Pattern Recognition, Computer Science - Robotics},
}

@article{bista_evaluating_2021,
	title = {Evaluating the {Impact} of {Semantic} {Segmentation} and {Pose} {Estimation} on {Dense} {Semantic} {SLAM}},
	url = {https://arxiv.org/abs/2109.07748v1},
	abstract = {Recent Semantic SLAM methods combine classical geometry-based estimation with deep learning-based object detection or semantic segmentation. In this paper we evaluate the quality of semantic maps generated by state-of-the-art class- and instance-aware dense semantic SLAM algorithms whose codes are publicly available and explore the impacts both semantic segmentation and pose estimation have on the quality of semantic maps. We obtain these results by providing algorithms with ground-truth pose and/or semantic segmentation data available from simulated environments. We establish that semantic segmentation is the largest source of error through our experiments, dropping mAP and OMQ performance by up to 74.3\% and 71.3\% respectively.},
	language = {en},
	urldate = {2021-09-22},
	author = {Bista, Suman Raj and Hall, David and Talbot, Ben and Zhang, Haoyang and Dayoub, Feras and Sünderhauf, Niko},
	month = sep,
	year = {2021},
}

@article{liu_large-scale_2021,
	title = {Large-scale {Autonomous} {Flight} with {Real}-time {Semantic} {SLAM} under {Dense} {Forest} {Canopy}},
	url = {http://arxiv.org/abs/2109.06479},
	abstract = {In this letter, we propose an integrated autonomous flight and semantic SLAM system that can perform long-range missions and real-time semantic mapping in highly cluttered, unstructured, and GPS-denied under-canopy environments. First, tree trunks and ground planes are detected from LIDAR scans. We use a neural network and an instance extraction algorithm to enable semantic segmentation in real time onboard the UAV. Second, detected tree trunk instances are modeled as cylinders and associated across the whole LIDAR sequence. This semantic data association constraints both robot poses as well as trunk landmark models. The output of semantic SLAM is used in state estimation, planning, and control algorithms in real time. The global planner relies on a sparse map to plan the shortest path to the global goal, and the local trajectory planner uses a small but finely discretized robot-centric map to plan a dynamically feasible and collision-free trajectory to the local goal. Both the global path and local trajectory lead to drift-corrected goals, thus helping the UAV execute its mission accurately and safely.},
	urldate = {2021-09-20},
	journal = {arXiv:2109.06479 [cs]},
	author = {Liu, Xu and Nardari, Guilherme V. and Ojeda, Fernando Cladera and Tao, Yuezhan and Zhou, Alex and Donnelly, Thomas and Qu, Chao and Chen, Steven W. and Romero, Roseli A. F. and Taylor, Camillo J. and Kumar, Vijay},
	month = sep,
	year = {2021},
	note = {arXiv: 2109.06479},
