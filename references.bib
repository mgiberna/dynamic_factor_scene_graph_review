@article{gehrung_approach_2017,
	title = {{AN} {APPROACH} {TO} {EXTRACT} {MOVING} {OBJECTS} {FROM} {MLS} {DATA} {USING} {A} {VOLUMETRIC} {BACKGROUND} {REPRESENTATION}},
	volume = {IV-1/W1},
